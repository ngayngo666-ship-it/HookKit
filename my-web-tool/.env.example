# Một khóa AI Gateway dùng cho OpenAI, Claude và các model khác.
# Lấy khóa tại Vercel → AI Gateway → API Keys, rồi copy file này thành .env.local
AI_GATEWAY_API_KEY=

# Khóa OpenAI trực tiếp. Khi có biến này, nút OpenAI không cần AI Gateway.
OPENAI_API_KEY=

# Khóa Gemini (Google AI Studio). Bắt buộc khi chọn Gemini trên trang chủ.
GEMINI_API_KEY=

# Tuỳ chọn. Bỏ trống để dùng model mặc định trong src/lib/ai-providers.js
OPENAI_MODEL=openai/gpt-5.6-terra
CLAUDE_MODEL=anthropic/claude-sonnet-5.5
GEMINI_MODEL=gemini-3.8-flash
