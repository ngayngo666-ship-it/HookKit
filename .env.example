# Bot két — copy thành .env hoặc đặt trên Railway Variables

# Bắt buộc
TELEGRAM_BOT_TOKEN=

# Admin = user id CÁ NHÂN Telegram (không phải id nhóm). Nhiều id: cách nhau bởi dấu phẩy.
ADMIN_USER_IDS=
# Alias cũ (cũng là user id admin, không dùng để chặn nhóm khác):
# ADMIN_CHAT_ID=

# Để trống = bot trả lời MỌI nhóm tại chỗ. Có list thì chỉ các chat_id đó.
# ALLOWED_CHAT_IDS=-100123,-100456

# Tự cấp quyền thành viên nhóm (nhân viên) + admin Telegram nhóm (quản trị). Mặc định bật.
# AUTO_GRANT_GROUP_MEMBERS=1

# Đồng bộ chức năng mọi nhóm (đọc CK + ảnh QR + file ảnh + nút + lệnh). Mặc định bật.
# SYNC_ALL_GROUPS=1
# Đọc ảnh gửi dạng file (không chỉ photo). Mặc định bật.
# READ_IMAGE_DOCUMENTS=1

# Để trống = mỗi nhóm một sổ. Đặt giá trị (vd. ket-chung) thì mọi nhóm dùng chung một két.
# SHARED_KET_ID=

# Lưu trữ SQLite (mặc định ./data/ket.db). Trên Railway gắn volume vào /data
# DATA_DIR=/data
# DB_PATH=/data/ket.db

# Ledger
# BIG_AMOUNT=50000000
# ALLOW_NEGATIVE=0
# REQUIRE_CUSTOMER=0

# Hành vi
# DEFAULT_DIRECTION=in
# BOT_TIMEZONE=Asia/Ho_Chi_Minh
# USE_AI_FALLBACK=0

# VietQR API (tuỳ chọn — QR ảnh dùng img.vietqr.io local)
# VIETQR_CLIENT_ID=
# VIETQR_API_KEY=
# VIETQR_TEMPLATE=compact2
