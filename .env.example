# Bot két — copy thành .env hoặc đặt trên Railway Variables

# Bắt buộc
TELEGRAM_BOT_TOKEN=

# Admin bootstrap (Telegram user id). Có thể nhiều id, cách nhau bởi dấu phẩy.
ADMIN_CHAT_ID=
# ADMIN_USER_IDS=111,222

# Lưu trữ SQLite (mặc định ./data/ket.db). Trên Railway gắn volume vào /data
# DATA_DIR=/data
# DB_PATH=/data/ket.db

# Ledger
# BIG_AMOUNT=50000000
# ALLOW_NEGATIVE=0
# REQUIRE_CUSTOMER=0

# Hành vi
# DEFAULT_DIRECTION=in
# BOT_TIMEZONE=Asia/Ho_Chi_Minh
# USE_AI_FALLBACK=0

# VietQR API (tuỳ chọn — QR ảnh dùng img.vietqr.io local)
# VIETQR_CLIENT_ID=
# VIETQR_API_KEY=
# VIETQR_TEMPLATE=compact2
