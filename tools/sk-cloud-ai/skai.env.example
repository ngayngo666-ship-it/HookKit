# Copy to skai.env (thư mục đang đứng, hoặc cạnh tool này). Không commit file thật.
# Key nào chưa dùng thì để nguyên dòng mẫu; lệnh không cần key đó sẽ bỏ qua.

# OpenAI chính thức — https://platform.openai.com/api-keys
# Lệnh: skai openai models | chat | edit
OPENAI_API_KEY=sk-your-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_ORG_ID=org-your-org
# OPENAI_PROJECT_ID=proj_your-project

# Cloud AI (Incord), tương thích OpenAI. Bỏ comment khi có key của Cloud AI.
# Khi key này còn là mẫu, chat/edit dùng OPENAI_API_KEY.
SK_CLOUD_AI_API_KEY=sk-your-api-key
# SK_CLOUD_AI_BASE_URL=https://api.incord.ai/v1/cloud
SK_CLOUD_AI_MODEL=gpt-4o-mini

# GitHub personal access token — https://github.com/settings/tokens
# Chỉ dùng trên máy này để kiểm tra tài khoản và repo. Không gửi token này sang Cursor.
GITHUB_TOKEN=github_pat_your-token

# Cursor API key — https://cursor.com/dashboard/api
# Cloud Agent chạy trên repo đã cài Cursor GitHub App.
CURSOR_API_KEY=cursor_your-api-key

# Xcode. Bỏ trống để skai tự chọn khi trong thư mục chỉ có một project và một scheme.
# Build/test chỉ chạy trên macOS có xcodebuild. --dry-run in lệnh trên mọi máy.
# XCODE_PROJECT=App.xcodeproj
# XCODE_WORKSPACE=App.xcworkspace
# XCODE_SCHEME=App
# XCODE_CONFIGURATION=Debug
# XCODE_DESTINATION=generic/platform=iOS
# XCODE_SDK=iphoneos

# Giây. Bỏ dòng này để dùng 60.
# SK_CLOUD_AI_TIMEOUT=60
